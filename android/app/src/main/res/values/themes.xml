<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Albunyaan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Design Spec Colors -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/primary_variant</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnPrimary">@color/onPrimary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <!-- Shape Theme (20dp corner radius) -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Albunyaan.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Albunyaan.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Albunyaan.LargeComponent</item>

        <!-- Bottom Navigation -->
        <item name="bottomNavigationStyle">@style/Widget.Albunyaan.BottomNavigationView</item>

        <!-- Navigation Rail (for tablets/TV) -->
        <item name="navigationRailStyle">@style/Widget.Albunyaan.NavigationRailView</item>

        <!-- Popup Menu Style -->
        <item name="popupMenuStyle">@style/Widget.Albunyaan.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Albunyaan.PopupMenu</item>

        <!-- Toolbar overflow popups (channel/playlist detail kebab, player
             kebab via MenuProvider). MaterialToolbar reads actionBarPopupTheme
             from the activity theme to style its overflow PopupMenu — the
             popupMenuStyle attributes above only reach standalone PopupMenu
             instances, not toolbar.inflateMenu(). Without this, the channel
             and playlist toolbar overflows fell back to Material3's default
             4 dp corner radius and bypassed Widget.Albunyaan.PopupMenu. -->
        <item name="actionBarPopupTheme">@style/ThemeOverlay.Albunyaan.PopupMenu</item>

        <!-- MaterialAlertDialog Theme (kebab pickers: quality, audio, subtitles,
             theme, language, and any other Material dialogs). Without this, the
             dialogs render with Material3's stock 4 dp corner radius and the
             default purple accent — visually out of place against the app's
             20 dp surfaces and primary-green buttons. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Albunyaan.MaterialAlertDialog</item>
    </style>

    <!-- Popup Menu Style (consistent with app design)
         Material3.PopupMenu defaults to a 4 dp corner radius via the framework
         popup background. Override with bg_popup_menu so the menu surface
         matches the app's 20 dp corner-radius design tokens. -->
    <style name="Widget.Albunyaan.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:overlapAnchor">false</item>
    </style>

    <!-- Toolbar overflow popup theme. MaterialToolbar's internal action-menu
         context is built from actionBarPopupTheme — that's what determines
         the popup background and item styling for the overflow kebab. We
         re-declare popupMenuStyle here so the Toolbar's popup picks up our
         branded background even though it doesn't read the activity-level
         popupMenuStyle directly. Parent is ThemeOverlay.Material3 (neutral,
         DayNight-aware) so colorSurface and other theme attrs continue to
         flow through from the host theme. -->
    <style name="ThemeOverlay.Albunyaan.PopupMenu" parent="ThemeOverlay.Material3">
        <item name="popupMenuStyle">@style/Widget.Albunyaan.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Albunyaan.PopupMenu</item>
    </style>

    <!-- Branded MaterialAlertDialog overlay applied via materialAlertDialogTheme.
         Picks up the app's 20 dp shape and primary-green accent so the
         "Quality" kebab picker on Shorts, the language/theme dialogs in
         Settings, and the various confirmation dialogs all look like the
         same family. -->
    <style name="ThemeOverlay.Albunyaan.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearance">@style/ShapeAppearance.Albunyaan.LargeComponent</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorAccent">@color/primary_green</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.Albunyaan.AlertDialog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.Albunyaan.AlertDialog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Albunyaan.AlertDialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Albunyaan.AlertDialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Albunyaan.AlertDialog.Button</item>
    </style>

    <style name="TextAppearance.Albunyaan.AlertDialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Albunyaan.AlertDialog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Albunyaan.AlertDialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_green</item>
    </style>

    <!-- Shape Appearances (Design Spec: 20dp radius) -->
    <style name="ShapeAppearance.Albunyaan.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_small</item>
    </style>

    <style name="ShapeAppearance.Albunyaan.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius</item>
    </style>

    <style name="ShapeAppearance.Albunyaan.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_large</item>
    </style>

    <!-- Bottom Navigation Style (Design Spec: 72dp) -->
    <style name="Widget.Albunyaan.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconSize">@dimen/icon_small</item>
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:minHeight">@dimen/bottom_nav_height</item>
    </style>

    <!-- Circle Shape for Channel Avatars -->
    <style name="ShapeAppearance.Albunyaan.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Navigation Rail Style (base - used on tablets) -->
    <!-- Note: itemIconTint/itemTextColor are set in layout XML to avoid duplication -->
    <style name="Widget.Albunyaan.NavigationRailView" parent="Widget.Material3.NavigationRailView">
        <item name="itemIconSize">@dimen/navigation_rail_icon_size</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
</resources>
