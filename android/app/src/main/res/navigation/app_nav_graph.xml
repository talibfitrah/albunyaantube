<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.albunyaan.tube.ui.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_splash_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_splash_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <!-- Plan C T8: now points to profileBootstrapFragment (was mainShellFragment
             T7 stub). T10 will finalize SignInFragment → splash redirect. -->
        <action
            android:id="@+id/action_splash_to_bootstrap"
            app:destination="@id/profileBootstrapFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.albunyaan.tube.ui.OnboardingFragment"
        android:label="Onboarding">
        <!-- Plan B (ANDROID-AUTH-01) T5: after onboarding completes, route to
             sign-in instead of straight to main. action_onboarding_to_main
             kept for back-compat / future skip-onboarding-when-signed-in. -->
        <action
            android:id="@+id/action_onboarding_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_onboarding_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
    </fragment>

    <!-- Plan B (ANDROID-AUTH-01) T5: top-level sign-in destination. -->
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.albunyaan.tube.ui.auth.SignInFragment"
        android:label="Sign in">
        <!-- Plan C T10: redirect via splash so SplashRouter makes the final
             routing decision (ACTIVE → main, PENDING_PROFILE → bootstrap,
             BLOCKED/DELETED → signIn). T12 fix: popUpTo graph root inclusive
             so back-press from the post-signIn splash doesn't surface a stale
             signIn instance. action_signIn_to_main removed (dead code). -->
        <action
            android:id="@+id/action_signIn_to_splash"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true" />
        <!-- Task 17: route unverified email/password to email verification. -->
        <action
            android:id="@+id/action_signIn_to_emailVerification"
            app:destination="@id/emailVerificationFragment"
            app:popUpTo="@id/signInFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Task 17: Email verification screen for newly signed up users. -->
    <fragment
        android:id="@+id/emailVerificationFragment"
        android:name="com.albunyaan.tube.ui.auth.EmailVerificationFragment"
        android:label="EmailVerification">
        <!-- Route to splash after email is verified. SplashRouter then decides
             final destination (main, bootstrap, or blocked). popUpTo inclusive
             prevents back-stack from restoring verification screen. -->
        <action
            android:id="@+id/action_emailVerification_to_splash"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/emailVerificationFragment"
            app:popUpToInclusive="true" />
        <!-- Route back to sign-in to restart auth (e.g. sign out, wrong email). -->
        <action
            android:id="@+id/action_emailVerification_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/emailVerificationFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/mainShellFragment"
        android:name="com.albunyaan.tube.ui.MainShellFragment"
        android:label="FitrahTube" />

    <!-- Plan C T8: ProfileBootstrap destination. -->
    <fragment
        android:id="@+id/profileBootstrapFragment"
        android:name="com.albunyaan.tube.ui.bootstrap.ProfileBootstrapFragment"
        android:label="Profile Bootstrap">
        <!-- Navigates to main shell after successful profile save.
             popUpTo splashFragment inclusive so back-stack is clean. -->
        <action
            android:id="@+id/action_bootstrap_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <!-- Navigates to age-ineligible screen on 422. -->
        <action
            android:id="@+id/action_bootstrap_to_ageIneligible"
            app:destination="@id/ageIneligibleFragment" />
        <!-- D11: back-nav cancels sign-in. Signs out and routes to signIn
             with a clean back-stack so the user isn't looped. -->
        <action
            android:id="@+id/action_bootstrap_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- Plan C T9: AgeIneligible terminal screen. -->
    <fragment
        android:id="@+id/ageIneligibleFragment"
        android:name="com.albunyaan.tube.ui.bootstrap.AgeIneligibleFragment"
        android:label="Age Ineligible">
        <!-- Navigates to sign-in after deleting Auth user + signing out.
             popUpTo splashFragment inclusive so back-stack is clean. -->
        <action
            android:id="@+id/action_ageIneligible_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
