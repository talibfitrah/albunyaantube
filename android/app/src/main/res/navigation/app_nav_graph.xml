<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/app_nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.albunyaan.tube.ui.SplashFragment"
        android:label="Splash">
        <action
            android:id="@+id/action_splash_to_onboarding"
            app:destination="@id/onboardingFragment"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_splash_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_splash_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <!-- Plan C T8: now points to profileBootstrapFragment (was mainShellFragment
             T7 stub). T10 will finalize SignInFragment → splash redirect. -->
        <action
            android:id="@+id/action_splash_to_bootstrap"
            app:destination="@id/profileBootstrapFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.albunyaan.tube.ui.OnboardingFragment"
        android:label="Onboarding">
        <!-- Plan B (ANDROID-AUTH-01) T5: after onboarding completes, route to
             sign-in instead of straight to main. action_onboarding_to_main
             kept for back-compat / future skip-onboarding-when-signed-in. -->
        <action
            android:id="@+id/action_onboarding_to_signIn"
            app:destination="@id/signInFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
        <action
            android:id="@+id/action_onboarding_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
    </fragment>

    <!-- Plan B (ANDROID-AUTH-01) T5: top-level sign-in destination. -->
    <fragment
        android:id="@+id/signInFragment"
        android:name="com.albunyaan.tube.ui.auth.SignInFragment"
        android:label="Sign in">
        <action
            android:id="@+id/action_signIn_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/app_nav_graph"
            app:popUpToInclusive="true"
            app:launchSingleTop="true"/>
    </fragment>

    <fragment
        android:id="@+id/mainShellFragment"
        android:name="com.albunyaan.tube.ui.MainShellFragment"
        android:label="FitrahTube" />

    <!-- Plan C T8: ProfileBootstrap destination. -->
    <fragment
        android:id="@+id/profileBootstrapFragment"
        android:name="com.albunyaan.tube.ui.bootstrap.ProfileBootstrapFragment"
        android:label="Profile Bootstrap">
        <!-- Navigates to main shell after successful profile save.
             popUpTo splashFragment inclusive so back-stack is clean. -->
        <action
            android:id="@+id/action_bootstrap_to_main"
            app:destination="@id/mainShellFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <!-- Navigates to age-ineligible screen on 422.
             T9 will repoint destination to ageIneligibleFragment once it exists. -->
        <action
            android:id="@+id/action_bootstrap_to_ageIneligible"
            app:destination="@id/mainShellFragment" />
    </fragment>

</navigation>
