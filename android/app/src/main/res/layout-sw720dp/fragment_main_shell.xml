<?xml version="1.0" encoding="utf-8"?>
<!-- Large tablet/TV layout (10"+ devices, 1080p TV boxes) with NavigationRail -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:layoutDirection="locale">

    <!-- NavigationRail for large tablets/TV (optimized for 10-foot D-pad navigation) -->
    <!-- Note: itemActiveIndicatorStyle=null disables the pill indicator to match phone BottomNav behavior -->
    <!-- IMPORTANT: itemIconTint/itemTextColor must be set here (not in theme) to be single source of truth.
         Any new NavigationRailView layouts must also set these attributes. -->
    <com.google.android.material.navigationrail.NavigationRailView
        android:id="@+id/mainBottomNav"
        android:layout_width="@dimen/navigation_rail_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/background_gray"
        android:elevation="@dimen/elevation_lg"
        android:paddingTop="@dimen/spacing_md"
        android:paddingBottom="@dimen/spacing_md"
        app:menuGravity="center"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Content area offset by NavigationRail width -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_shell_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/navigation_rail_width"
        app:navGraph="@navigation/main_tabs_nav"
        app:defaultNavHost="false" />

    <!-- Non-blocking offline banner — shown when NetworkMonitor reports no connectivity.
         Offset by NavigationRail width so it does not overlap the rail. -->
    <TextView
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="@dimen/navigation_rail_width"
        android:background="?attr/colorErrorContainer"
        android:elevation="@dimen/elevation_lg"
        android:gravity="center"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:text="@string/connectivity_offline_banner"
        android:textColor="?attr/colorOnErrorContainer"
        android:textSize="14sp"
        android:visibility="gone"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
