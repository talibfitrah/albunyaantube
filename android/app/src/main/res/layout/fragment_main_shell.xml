<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_gray"
    android:layoutDirection="locale">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/main_shell_nav_host"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:navGraph="@navigation/main_tabs_nav"
        app:defaultNavHost="false" />

    <!-- Non-blocking offline banner — shown when NetworkMonitor reports no connectivity.
         Visibility toggled from MainShellFragment. -->
    <LinearLayout
        android:id="@+id/offlineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="?attr/colorErrorContainer"
        android:elevation="@dimen/elevation_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_cloud_off"
            app:tint="?attr/colorOnErrorContainer"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/connectivity_offline_banner"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnErrorContainer"
            android:textAlignment="viewStart" />

    </LinearLayout>

    <!-- itemActiveIndicatorStyle=@null matches the sw600dp/sw720dp rails, which
         disable the M3 pill indicator "to match phone BottomNav behavior". The
         phone layout never set it, so the active tab drew Material's baseline
         purple pill (the theme defines no colorSecondaryContainer). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/mainBottomNav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@color/background_gray"
        android:elevation="@dimen/elevation_lg"
        android:paddingStart="@dimen/spacing_none"
        android:paddingEnd="@dimen/spacing_none"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemRippleColor="@android:color/transparent"
        app:itemActiveIndicatorStyle="@null"
        app:itemHorizontalTranslationEnabled="false"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
