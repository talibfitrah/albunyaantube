<?xml version="1.0" encoding="utf-8"?>
<!-- Download icon. Uses theme tint so the glyph is visible on both
     light and dark surfaces wherever the icon is rendered without an
     explicit app:tint (e.g. PopupMenu items). Places that tint the
     ImageView/Button explicitly (action bar buttons, branded chips)
     still win — this only matters when the host applies no tint. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M19,9h-4V3H9v6H5l7,7 7,-7zM5,18v2h14v-2H5z"/>
</vector>
