<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- FOREGROUND_SERVICE required for Android 9 (API 28); typed permissions for Android 14+ (API 34) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ANDROID-FLAVOR-01: REQUEST_INSTALL_PACKAGES and UPDATE_PACKAGES_WITHOUT_USER_ACTION
         live in app/src/sideload/AndroidManifest.xml, NOT here. Google Play's Device and
         Network Abuse policy forbids self-installing APKs and Play scans the merged
         manifest, so these must be structurally absent from the `play` flavor rather than
         gated at runtime. Do not move them back into src/main. -->

    <application
        android:name=".AlBunyaanApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Albunyaan"
        android:networkSecurityConfig="@xml/network_security_config">
        <profileable
            android:shell="${profileable}"
            tools:targetApi="29" />

        <!-- ANDROID-SDK36-01: android:enableOnBackInvokedCallback is deliberately
             ABSENT, which means it defaults to true at targetSdk 36. Do not add it
             set to "false" — that would opt the app out of Android 16's predictive
             back and is not needed: every back handler in the app already routes
             through androidx OnBackPressedCallback on onBackPressedDispatcher
             (MainActivity, AgeIneligibleFragment, ProfileBootstrapFragment,
             EmailVerificationFragment). There is no onBackPressed() override and
             no KEYCODE_BACK handling anywhere, so the migration Android 16 asks
             for was already complete before the targetSdk bump.

             Also deliberately absent: PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY.
             The app declares no android:screenOrientation, resizableActivity,
             minAspectRatio or maxAspectRatio, and already ships adaptive
             layout-sw600dp/ and layout-sw720dp/ variants, so it has nothing to opt
             out of. The opt-out is temporary in any case — it stops working at
             targetSdk 37. -->
        <activity
            android:name="com.albunyaan.tube.ui.MainActivity"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="albunyaantube"
                    android:host="channel" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="albunyaantube"
                    android:host="playlist" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="albunyaantube"
                    android:host="video" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/watch/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/api/watch/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/channel/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/api/channel/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/playlist/" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.fitrahtube.com"
                    android:pathPrefix="/api/playlist/" />
            </intent-filter>
        </activity>

        <!-- Media3 MediaSessionService for background playback and media controls -->
        <service
            android:name="com.albunyaan.tube.player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.downloads.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/downloads_file_paths" />
        </provider>

        <!-- ANDROID-FLAVOR-01: InstallStatusActivity is declared in
             app/src/sideload/AndroidManifest.xml — the class itself only exists in the
             sideload source set. See the uses-permission note at the top of this file. -->

        <!-- Google Cast SDK configuration -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.albunyaan.tube.player.CastOptionsProvider" />

        <!-- Disable default WorkManager initializer to use Hilt WorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- WorkManager foreground service for downloads (Android 14+ requires foregroundServiceType) -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
