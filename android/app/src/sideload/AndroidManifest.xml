<?xml version="1.0" encoding="utf-8"?>
<!--
  ANDROID-FLAVOR-01 — sideload-only manifest surface.

  Everything in this file is what Google Play's Device and Network Abuse policy
  forbids: an app that downloads an APK and installs it itself. Play scans the
  MERGED manifest, so a runtime `InstallSource.isPlayStore()` check is not enough —
  the declarations have to be missing from the Play artifact entirely. Because this
  file belongs to the `sideload` product flavor, the manifest merger never sees it
  when building `play*` variants.

  Do NOT move any of this into src/main.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ANDROID-MULTI-01 Issue 3: required to hand off downloaded APKs to the package
         installer. On Android 8+ the user must separately grant "install unknown apps"
         via Settings; the app flow walks them through this on first use. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+ (API 31): lets the in-app updater install a self-update without the system
         install-confirmation step, via
         PackageInstaller.SessionParams.setRequireUserAction(USER_ACTION_NOT_REQUIRED). Only that
         confirmation is waived — Play Protect still verifies on commit (a block surfaces as
         STATUS_FAILURE). Normal permission, auto-granted. Older APIs ignore it and keep the
         confirm flow. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!--
          Transparent trampoline Activity for PackageInstaller status callbacks.
          The PendingIntent created in ApkInstaller.launchInstaller delivers here.
          Uses an Activity (not BroadcastReceiver) so the OS launches it directly
          via PendingIntent — Huawei/Honor BAL restrictions block startActivity
          from a BroadcastReceiver context. excludeFromRecents keeps it out of
          the task switcher; taskAffinity="" prevents it from joining the main
          task stack.
        -->
        <activity
            android:name=".update.InstallStatusActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="" />
    </application>

</manifest>
