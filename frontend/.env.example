# Firebase Configuration
# Get these values from Firebase Console > Project Settings > Your Apps
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Backend API
VITE_API_BASE_URL=http://localhost:8080

# YouTube Data API v3 (optional)
# WARNING: VITE_ prefix means this key is bundled into client-side JavaScript and
# can be extracted from browser DevTools or the built JS bundle. To mitigate abuse:
#   1. MUST set HTTP referrer restrictions in Google Cloud Console
#   2. Set aggressive daily quota caps (default 10,000 units/day)
#   3. Enable quota alerts in Google Cloud Console > APIs & Services > Quotas
# The recommended default is to leave this empty and use the backend NewPipe proxy.
# If not set, falls back to backend NewPipe proxy (no API key / quota limits).
VITE_YOUTUBE_API_KEY=

# Firebase Emulator (optional for local development)
VITE_USE_FIREBASE_EMULATOR=false
