{
  "name": "albunyaan-tube-admin",
  "version": "1.0.0-beta.14",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run generate:api",
    "build": "vue-tsc --noEmit && vite build",
    "prebuild": "npm run generate:api",
    "preview": "vite preview",
    "test": "timeout 300s vitest run",
    "pretest": "npm run generate:api",
    "test:e2e": "npm run build && playwright test",
    "generate:api": "openapi-typescript ../docs/architecture/api-specification.yaml -o src/generated/api/schema.ts"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "axios": "^1.19.0",
    "firebase": "^12.17.1",
    "papaparse": "^5.6.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.41",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "terser": "^5.50.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  }
}
