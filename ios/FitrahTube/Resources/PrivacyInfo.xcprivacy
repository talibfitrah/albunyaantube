<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Required since 2024-05-01; without it App Store privacy validation can reject the archive
  (codex-P1, docs/architecture/ios-app-plan.md:344).

  Nothing is tracked: phase 1 is guest-only, there is no analytics SDK, no IDFA/IDFV read, and no
  PII leaves the device. One thing *is* collected under Apple's definition and is declared below:
  the locally generated `X-Device-Id` UUID that `DeviceIdMiddleware` sends on every request and the
  backend retains with `POST /api/v1/reports`. It is a rate-limit/report bucket, not tied to a
  person -- hence Device ID / App Functionality, not linked to identity, not used for tracking
  (gate wave-2 W7: an empty array here while that header ships is an App Review rejection risk).

  Required-reason APIs actually used:
  - UserDefaults (CA92.1) — settings, filters, search history, onboarding flag; read and written
    only by this app, never shared with a data broker.
  - System boot time (35F9.1) — `ProcessInfo.systemUptime` in `TapGate` (About's 7-taps-in-3s
    developer gesture), used to measure elapsed time inside the app.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
