    "onboarding_help_body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلخّص الشرائح رسالة فطرة تيوب ونهج اختيار المحتوى الآمن وسياسة التحميل."
          }
