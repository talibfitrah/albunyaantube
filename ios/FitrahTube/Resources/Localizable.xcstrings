    "import_caution_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كن واعيًا لما تُدخله. أنت وحدك المسؤول أمام الله عمّا تضيفه من محتوى. اختر فقط ما هو حلال وموافق للشريعة كما يفهمها أهل السنة، واتقِ الله في اختياراتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Be mindful of what you bring in. You alone are responsible before Allah for the content you add. Choose only what is halāl and in keeping with the Sharī'ah as understood by Ahl us-Sunnah, and fear Allah in your choices."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wees bewust van wat je toevoegt. Jij alleen bent verantwoording verschuldigd aan Allah voor de inhoud die je toevoegt. Kies alleen wat halal is en in overeenstemming met de Sharia zoals begrepen door Ahl us-Sunnah, en vrees Allah in je keuzes."
          }
        }
      }
    },
    "import_caution_title": {
      "localizations": {
        "ar": {
