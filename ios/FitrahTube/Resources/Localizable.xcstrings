    "update_body_generic": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر إصدار جديد. ننصح بتثبيته — قد لا تعمل الإصدارات الأقدم بنفس الكفاءة التي اعتدت عليها."
