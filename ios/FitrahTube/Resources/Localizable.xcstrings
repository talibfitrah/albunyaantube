            "state": "translated",
            "value": "Dia's geven een samenvatting van FitrahTube's missie, veilige contentselectie en downloadbeleid."
          }
        }
      }
    },
    "onboarding_page1_desc": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف مجموعة متنوعة من الفيديوهات الإسلامية، من المحاضرات إلى الوثائقيات، كلها في مكان واحد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore a diverse collection of Islamic videos, from lectures to documentaries, all in one place."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontdek een diverse collectie islamitische video's, van lezingen tot documentaires, allemaal op één plek."
          }
        }
      }
    },
