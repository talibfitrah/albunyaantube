        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version is available. We recommend installing it — older versions may not perform as well as you're used to."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een nieuwe versie beschikbaar. We raden aan deze te installeren — oudere versies presteren mogelijk niet zo goed als je gewend bent."
          }
        }
      }
