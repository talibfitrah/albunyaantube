// Owner's Apple Developer Team ID (rulings.md Amendment 2). Drives DEVELOPMENT_TEAM and, through
// Info.plist's FITRAH_APPLE_SIGNIN, whether the app offers Sign in with Apple at all.
FITRAH_TEAM_ID = 72PF8SBQR6
// Google Sign-In's OAuth callback scheme (the REVERSED_CLIENT_ID out of GoogleService-Info.plist).
// Empty here because that file is USER-BLOCKED and git-ignored: Local.xcconfig supplies the real
// value the day the plist lands.
GID_REVERSED_CLIENT_ID =
// Local.xcconfig may set FITRAH_TEAM_ID and GID_REVERSED_CLIENT_ID only; API_BASE_URL is fixed for
// Release.
#include? "Local.xcconfig"
API_BASE_URL = https:/$()/app.fitrahtube.com/
